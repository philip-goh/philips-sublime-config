{
    "show_diagnostics_count_in_view_status": true,
    "diagnostics_gutter_marker": "sign",

    "clients": {
        // Unity (and Godot Mono) C# support. bootstrap.sh installs the .NET
        // SDK into ~/.dotnet; LSP prepends that path to the OmniSharp
        // process's PATH so it finds the runtime even when Sublime was
        // launched from a GUI without a login shell's PATH.
        "LSP-OmniSharp": {
            "enabled": true,
            "env": {
                "PATH": "$home/.dotnet"
            }
        },

        // GDScript support (Godot's own scripting language, syntax from the
        // bootstrap-installed Godot Tools package). This connects to the
        // language server built into the Godot editor on TCP 6005; start it
        // with "Godot: Setup LSP For Current Project". Set "enabled": false
        // if you edit .gd files without Godot running.
        "godot-lsp": {
            "enabled": true,
            "tcp_port": 6005,
            "selector": "source.gdscript"
        }
    },

    // Global "lsp_format_on_save" is deliberately NOT enabled: this config is
    // used across shared codebases, and format-on-save is a per-project
    // decision. Enable it in a .sublime-project instead (see
    // project-template.sublime-project), like so:
    //
    // "settings": {
    //     "lsp_format_on_save": true,
    //     "lsp_code_actions_on_save": {
    //         "source.fixAll.ruff": true,
    //         "source.organizeImports.ruff": true
    //     }
    // }
}
