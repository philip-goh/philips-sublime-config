[
    // LSP — these commands ship unbound; each binding only fires when the
    // active file has a server with the matching capability, so f12 etc.
    // fall back to Sublime's built-in behavior everywhere else.
    {
        "keys": ["f12"],
        "command": "lsp_symbol_definition",
        "context": [
            {"key": "lsp.session_with_capability", "operator": "equal", "operand": "definitionProvider"}
        ]
    },
    {
        "keys": ["shift+f12"],
        "command": "lsp_symbol_references",
        "context": [
            {"key": "lsp.session_with_capability", "operator": "equal", "operand": "referencesProvider"}
        ]
    },
    {
        "keys": ["f2"],
        "command": "lsp_symbol_rename",
        "context": [
            {"key": "lsp.session_with_capability", "operator": "equal", "operand": "renameProvider"}
        ]
    },
    {
        "keys": ["super+."],
        "command": "lsp_code_actions",
        "context": [
            {"key": "lsp.session_with_capability", "operator": "equal", "operand": "codeActionProvider"}
        ]
    },
    {
        "keys": ["super+alt+f"],
        "command": "lsp_format_document",
        "context": [
            {"key": "lsp.session_with_capability", "operator": "equal", "operand": "documentFormattingProvider | documentRangeFormattingProvider"}
        ]
    },
    {
        "keys": ["super+k", "super+i"],
        "command": "lsp_hover",
        "context": [
            {"key": "lsp.session_with_capability", "operator": "equal", "operand": "hoverProvider"}
        ]
    },

    // Terminus — ctrl+` is Sublime's console, so use alt+` for the terminal.
    {
        "keys": ["alt+`"],
        "command": "toggle_terminus_panel"
    }
]
